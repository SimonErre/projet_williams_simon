# URL de connexion PostgreSQL fournie par Render (onglet "External Database URL" pour le dev en local)
DATABASE_URL=postgres://votre_user:votre_password@dpg-xxxxxx.render.com/nom_de_votre_base

# Port du serveur de l'API (optionnel, 3000 par défaut)
PORT=3000

# Activer/Désactiver SSL (true par défaut sauf si localhost)
# DB_SSL=true
